{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    /* Lit 3 with TypeScript's legacy decorators. `useDefineForClassFields`
       must stay off, or class fields overwrite the accessors @property
       installs and reactive updates silently stop firing. */
    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["geojson"]
  },
  "include": ["src", "dev", "studio", "vite.config.ts"]
}
